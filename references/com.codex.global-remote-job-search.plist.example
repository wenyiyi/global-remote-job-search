<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.codex.global-remote-job-search</string>
  <key>WorkingDirectory</key><string>/Users/YOU/.codex/skills/global-remote-job-search</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>scripts/job_search.py</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOU/.codex/skills/global-remote-job-search/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/.codex/skills/global-remote-job-search/logs/launchd-error.log</string>
</dict></plist>
